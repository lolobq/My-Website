{
  "ci": {
    "collect": {
      "startServerCommand": "node tests/serve-gz.mjs 4176",
      "startServerReadyPattern": "Available on",
      "startServerReadyTimeout": 15000,
      "url": [
        "http://127.0.0.1:4176/index.html",
        "http://127.0.0.1:4176/resume.html",
        "http://127.0.0.1:4176/projects.html",
        "http://127.0.0.1:4176/contact.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 1048576 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 102400 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
