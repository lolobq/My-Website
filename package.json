{
  "name": "lauren-bourque-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only test tooling for the static portfolio site. The site itself has no build step.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "serve": "http-server . -p 4173 -c-1 --silent",
    "test:baseline": "playwright test --project=baseline-mobile --project=baseline-desktop",
    "test:baseline:update": "cross-env BASELINE_UPDATE=1 playwright test --project=baseline-mobile --project=baseline-desktop",
    "test:e2e": "playwright test --project=mobile --project=desktop --grep-invert @a11y",
    "test:e2e:cross": "cross-env CROSS_BROWSER=1 playwright test --project=webkit-mobile --project=firefox-desktop --grep-invert @a11y",
    "test:a11y": "playwright test --project=mobile --project=desktop --grep @a11y",
    "test:html": "html-validate \"*.html\"",
    "test:links": "node tests/links.mjs",
    "test:content": "node tests/content-integrity.mjs",
    "test:lhci": "lhci autorun",
    "test:unit": "vitest run",
    "test:all": "npm run test:content && npm run test:html && npm run test:unit && npm run test:e2e && npm run test:a11y && npm run test:links && npm run test:lhci",
    "test": "npm run test:all"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.58.2",
    "cross-env": "7.0.3",
    "html-validate": "8.29.0",
    "http-server": "14.1.1",
    "jsdom": "26.1.0",
    "linkinator": "6.3.0",
    "vitest": "2.1.9"
  }
}
